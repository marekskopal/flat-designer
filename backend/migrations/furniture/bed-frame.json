    "z": 0,
    "w": "W",
    "h": "H",
    "d": 40,
    "material": "frame",
    "grain": "horizontal",
    "edges": [
     "top",
     "left",
     "right"
    ]
   },
   {
    "type": "board",
    "name": "Side rail",
    "repeat": {
     "count": 2
    },
    "x": "i * (W - 30)",
