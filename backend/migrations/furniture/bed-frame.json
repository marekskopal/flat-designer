    "w": 30,
    "h": 200,
    "d": "D - 40",
    "material": "frame",
    "grain": "horizontal"
   },
   {
    "type": "board",
    "name": "Foot rail",
    "x": 30,
    "y": "railHeight - 200",
    "z": "D - 30",
    "w": "W - 60",
    "h": 200,
    "d": 30,
    "material": "frame",
    "grain": "horizontal"
   },
   {
    "type": "board",
    "name": "Slat",
    "repeat": {
     "count": "slats"
