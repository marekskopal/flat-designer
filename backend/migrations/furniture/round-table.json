{
 "name": "Round table",
 "description": "Round or oval side, coffee or dining table: a round top, or an oval one (rounded ends, when wider than deep), on a pedestal pedestal mm thick with a foot disc (a fluted drum in a fluted material), or on four legs.",
 "definition": {
  "format": 1,
  "catalogue": "tables",
  "translations": {
   "cs": {
    "name": "Kulatý stůl",
    "description": "Kulatý nebo oválný odkládací, konferenční či jídelní stůl: kulatá deska, nebo oválná (zaoblené konce, je-li širší než hlubší), na centrální noze tlusté pedestal mm s patkou (v drážkovaném materiálu drážkovaný válec), nebo na čtyřech nohách.",
    "parameters": {
     "base": "Podnož",
     "top": "Tloušťka desky",
     "shape": "Tvar desky",
     "pedestal": "Šířka centrální nohy"
    },
    "options": {
     "base": {
      "pedestal": "centrální noha",
      "legs": "čtyři nohy"
     },
     "shape": {
      "round": "kulatá",
      "oval": "oválná"
     }
    },
    "slots": {
     "top": "Deska",
     "base": "Podnož"
    },
    "parts": {
     "Top": "Deska",
     "Pedestal": "Centrální noha",
     "Foot disc": "Patka",
     "Leg": "Noha",
     "Top end": "Konec desky"
    }
   }
  },
  "size": {
   "width": 560,
   "depth": 560,
   "height": 500
  },
  "parameters": [
   {
    "key": "shape",
    "label": "Top shape",
    "type": "select",
    "default": "round",
    "options": [
     "round",
     "oval"
    ]
   },
   {
    "key": "base",
    "label": "Base",
    "type": "select",
    "default": "pedestal",
    "options": [
     "pedestal",
     "legs"
    ]
   },
   {
    "key": "top",
    "label": "Top thickness",
    "type": "int",
    "default": 25,
    "min": 12,
    "max": 60,
    "unit": "mm"
   },
   {
    "key": "pedestal",
    "label": "Pedestal width",
    "type": "int",
    "default": 50,
    "min": 30,
    "max": 600,
    "unit": "mm"
   }
  ],
  "derived": {
   "foot": "max(min(W, D) * 0.55, pedestal + 60)",
   "oval": "shape == 'oval' && W > D"
  },
  "materialSlots": [
   {
    "key": "top",
    "label": "Top",
    "default": "oak-veneer"
   },
   {
    "key": "base",
    "label": "Base",
    "default": "matt-black"
   }
  ],
  "parts": [
   {
    "type": "cylinder",
    "name": "Top",
    "x": 0,
    "y": "H - top",
    "z": 0,
    "w": "W",
    "h": "top",
    "d": "D",
    "material": "top",
    "when": "!oval"
   },
   {
    "type": "block",
    "name": "Top",
    "when": "oval",
    "x": "D / 2",
    "y": "H - top",
    "z": 0,
    "w": "W - D",
    "h": "top",
    "d": "D",
    "material": "top"
   },
   {
    "type": "cylinder",
    "name": "Top end",
    "when": "oval",
    "repeat": {
     "count": 2
    },
    "x": "i * (W - D)",
    "y": "H - top",
    "z": 0,
    "w": "D",
    "h": "top",
    "d": "D",
    "material": "top"
   },
   {
    "type": "cylinder",
    "name": "Pedestal",
    "when": "base == 'pedestal'",
    "x": "W / 2 - pedestal / 2",
    "y": 15,
    "z": "D / 2 - pedestal / 2",
    "w": "pedestal",
    "h": "H - top - 15",
    "d": "pedestal",
    "material": "base"
   },
   {
    "type": "cylinder",
    "name": "Foot disc",
    "when": "base == 'pedestal'",
    "x": "(W - foot) / 2",
    "y": 0,
    "z": "(D - foot) / 2",
    "w": "foot",
    "h": 15,
    "d": "foot",
    "material": "base"
   },
   {
    "type": "cylinder",
    "name": "Leg",
    "when": "base == 'legs'",
    "repeat": {
     "count": 4
    },
    "x": "W / 2 - 15 + (i % 2 * 2 - 1) * W * 0.28",
    "y": 0,
    "z": "D / 2 - 15 + (floor(i / 2) * 2 - 1) * D * 0.28",
    "w": 30,
    "h": "H - top",
    "d": 30,
    "material": "base"
   }
  ]
 }
}
