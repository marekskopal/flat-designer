{
 "name": "Sideboard",
 "description": "Low cabinet with doors (handles at the meeting edges) and a shelf behind them, an optional row of drawers with their boxes above them, on a plinth or legs. softClose damps the closing of the doors and drawers.",
 "definition": {
  "format": 1,
  "catalogue": "storage",
  "translations": {
   "cs": {
    "name": "Komoda",
    "description": "Nízká skříňka s dvířky (úchytky u styku křídel) a policí za nimi, volitelně s řadou zásuvek s těly nad nimi, na soklu nebo nohách. softClose tlumí dovírání dvířek a zásuvek.",
    "parameters": {
     "doors": "Dvířka",
     "drawers": "Zásuvky nad dvířky",
     "base": "Podnož",
     "t": "Tloušťka desek",
     "softClose": "Tlumené dovírání"
    },
    "options": {
     "base": {
      "plinth": "sokl",
      "legs": "nohy"
     }
    },
    "slots": {
     "carcass": "Korpus",
     "fronts": "Čela"
    },
    "parts": {
     "Side": "Bok",
     "Top": "Víko",
     "Bottom": "Dno",
     "Back": "Záda",
     "Shelf": "Police",
     "Plinth": "Sokl",
     "Leg": "Noha",
     "Drawer": "Zásuvka",
     "Drawer side": "Bok zásuvky",
     "Drawer bottom": "Dno zásuvky",
     "Drawer back": "Záda zásuvky",
     "Drawer inner front": "Vnitřní čelo zásuvky",
     "Door": "Dvířka"
    }
   }
  },
  "size": {
   "width": 1600,
   "depth": 450,
   "height": 800
  },
  "parameters": [
   {
    "key": "doors",
    "label": "Doors",
    "type": "int",
    "default": 2,
    "min": 1,
    "max": 6
   },
   {
    "key": "drawers",
    "label": "Drawers above the doors",
    "type": "bool",
    "default": true
   },
   {
    "key": "base",
    "label": "Base",
    "type": "select",
    "default": "plinth",
    "options": [
     "plinth",
     "legs"
    ]
   },
   {
    "key": "t",
    "label": "Board thickness",
    "type": "int",
    "default": 19,
    "min": 16,
    "max": 30,
    "unit": "mm"
   },
   {
    "key": "softClose",
    "label": "Soft close",
    "type": "bool",
    "default": true
   }
  ],
  "derived": {
   "f": "19",
   "b": "base == 'legs' ? 150 : 80",
   "ch": "H - b",
   "fw": "W / doors",
   "dh": "drawers ? 160 : 0"
  },
  "materialSlots": [
   {
    "key": "carcass",
    "label": "Carcass",
    "default": "kitchen-oak"
   },
   {
    "key": "fronts",
    "label": "Fronts",
    "default": "furniture-white-matt"
   }
  ],
  "parts": [
   {
    "type": "board",
    "name": "Side",
    "repeat": {
     "count": 2
    },
    "x": "i * (W - t)",
    "y": "b",
    "z": 0,
    "w": "t",
    "h": "ch - t",
    "d": "D - f",
    "material": "carcass"
   },
   {
    "type": "board",
    "name": "Top",
    "x": 0,
    "y": "H - t",
    "z": 0,
    "w": "W",
    "h": "t",
    "d": "D - f",
    "material": "carcass",
    "grain": "horizontal",
    "edges": [
     "front",
     "left",
     "right"
    ]
   },
   {
    "type": "board",
    "name": "Bottom",
    "x": "t",
    "y": "b",
    "z": 0,
    "w": "W - 2*t",
    "h": "t",
    "d": "D - f",
    "material": "carcass",
    "grain": "horizontal"
   },
   {
    "type": "board",
    "name": "Back",
    "x": "t",
    "y": "b + t",
    "z": 0,
    "w": "W - 2*t",
    "h": "ch - 2*t",
    "d": 4,
    "material": "carcass"
   },
   {
    "type": "board",
    "name": "Shelf",
    "when": "ch - t - dh > 500",
    "x": "t",
    "y": "b + round((ch - t - dh) / 2)",
    "z": 20,
    "w": "W - 2*t",
    "h": "t",
    "d": "D - f - 40",
    "material": "carcass",
    "grain": "horizontal",
    "edges": [
     "front"
    ]
   },
   {
    "type": "board",
    "name": "Plinth",
    "when": "base == 'plinth'",
    "x": 20,
    "y": 0,
    "z": 20,
    "w": "W - 40",
    "h": "b",
    "d": "D - f - 60",
    "material": "carcass",
    "grain": "horizontal"
   },
   {
    "type": "taperedLeg",
    "name": "Leg",
    "when": "base == 'legs'",
    "repeat": {
     "count": 4
    },
    "x": "10 + i % 2 * (W - 70)",
    "y": 0,
    "z": "10 + floor(i / 2) * (D - f - 70)",
    "w": 50,
    "h": "b",
    "d": 50,
    "material": "carcass",
    "bottomSize": 30
   },
   {
    "type": "assembly",
    "name": "Drawer",
    "when": "drawers",
    "repeat": {
     "count": "doors"
    },
    "x": "i * fw + 2",
    "y": "H - t - dh + 2",
    "z": 10,
    "w": "fw - 4",
    "h": "dh - 4",
    "d": "D - 10",
    "opens": "slide",
    "softClose": {
     "expr": "softClose"
    },
    "parts": [
     {
      "type": "front",
      "name": "Drawer",
      "x": 0,
      "y": 0,
      "z": "AD - f",
      "w": "AW",
      "h": "AH",
      "d": "f",
      "material": "fronts",
      "kind": "drawer",
      "handle": "horizontal"
     },
     {
      "type": "board",
      "name": "Drawer side",
      "repeat": {
       "count": 2,
       "as": "s"
      },
      "x": "s == 0 ? (i == 0 ? t : 0) + 12 : AW - (i == doors - 1 ? t : 0) - 28",
      "y": 30,
      "z": 10,
      "w": 16,
      "h": "max(AH - 70, 30)",
      "d": "AD - f - 10",
      "material": "carcass",
      "edges": [
       "top"
      ]
     },
     {
      "type": "board",
      "name": "Drawer bottom",
      "x": "(i == 0 ? t : 0) + 28",
      "y": 30,
      "z": 10,
      "w": "AW - (i == 0 ? t : 0) - (i == doors - 1 ? t : 0) - 56",
      "h": 8,
      "d": "AD - f - 10",
      "material": "carcass",
      "grain": "horizontal"
     },
     {
      "type": "board",
      "name": "Drawer back",
      "x": "(i == 0 ? t : 0) + 28",
      "y": 38,
      "z": 10,
      "w": "AW - (i == 0 ? t : 0) - (i == doors - 1 ? t : 0) - 56",
      "h": "max(AH - 78, 22)",
      "d": 16,
      "material": "carcass",
      "grain": "horizontal",
      "edges": [
       "top"
      ]
     },
     {
      "type": "board",
      "name": "Drawer inner front",
      "x": "(i == 0 ? t : 0) + 28",
      "y": 38,
      "z": "AD - f - 16",
      "w": "AW - (i == 0 ? t : 0) - (i == doors - 1 ? t : 0) - 56",
      "h": "max(AH - 78, 22)",
      "d": 16,
      "material": "carcass",
      "grain": "horizontal",
      "edges": [
       "top"
      ]
     }
    ]
   },
   {
    "type": "front",
    "name": "Door",
    "when": "i < doors / 2",
    "repeat": {
     "count": "doors"
    },
    "x": "i * fw + 2",
    "y": "b + 2",
    "z": "D - f",
    "w": "fw - 4",
    "h": "ch - t - dh - 4",
    "d": "f",
    "material": "fronts",
    "kind": "door",
    "handle": "vertical",
    "handleSide": "right",
    "softClose": {
     "expr": "softClose"
    }
   },
   {
    "type": "front",
    "name": "Door",
    "when": "i >= doors / 2",
    "repeat": {
     "count": "doors"
    },
    "x": "i * fw + 2",
    "y": "b + 2",
    "z": "D - f",
    "w": "fw - 4",
    "h": "ch - t - dh - 4",
    "d": "f",
    "material": "fronts",
    "kind": "door",
    "handle": "vertical",
    "handleSide": "left",
    "softClose": {
     "expr": "softClose"
    }
   }
  ]
 }
}
