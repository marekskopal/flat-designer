      "z": 10,
      "w": 16,
      "h": "max(AH - 40, 30)",
      "d": "AD - t - 10",
      "material": "body",
      "edges": [
       "top"
      ]
     },
     {
      "type": "board",
      "name": "Drawer bottom",
      "x": "10 + 16",
      "y": 15,
      "z": 10,
      "w": "AW - 2 * 10 - 32",
      "h": 8,
      "d": "AD - t - 10",
      "material": "body",
      "grain": "horizontal"
     },
     {
      "type": "board",
      "name": "Drawer back",
      "x": "10 + 16",
      "y": 23,
      "z": 10,
      "w": "AW - 2 * 10 - 32",
      "h": "max(AH - 48, 22)",
      "d": 16,
      "material": "body",
      "grain": "horizontal",
      "edges": [
       "top"
      ]
     },
     {
      "type": "board",
      "name": "Drawer inner front",
      "x": "10 + 16",
      "y": 23,
      "z": "AD - t - 16",
      "w": "AW - 2 * 10 - 32",
      "h": "max(AH - 48, 22)",
      "d": 16,
      "material": "body",
      "grain": "horizontal",
      "edges": [
       "top"
      ]
     }
    ]
   },
   {
    "type": "taperedLeg",
    "name": "Leg",
    "when": "legHeight > 0",
    "repeat": {
     "count": 4
    },
    "x": "i % 2 * (W - 40)",
    "y": 0,
    "z": "floor(i / 2) * (D - 40)",
    "w": 40,
    "h": "legHeight",
    "d": 40,
    "bottomSize": 22,
    "material": "body"
   }
  ]
 }
