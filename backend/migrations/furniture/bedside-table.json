    "min": 0,
    "max": 350,
    "unit": "mm"
   },
   {
    "key": "softClose",
    "label": "Soft close",
    "type": "bool",
    "default": true
   }
  ],
  "derived": {
   "t": "18",
   "body": "H - legHeight",
   "dh": "min(160, body - 2 * t - 4)"
  },
  "materialSlots": [
   {
    "key": "body",
    "label": "Body",
    "default": "oak-veneer"
   },
   {
    "key": "front",
    "label": "Drawer front",
    "default": "oak-veneer"
   }
  ],
  "parts": [
   {
    "type": "board",
    "name": "Top",
    "x": 0,
    "y": "H - t",
    "z": 0,
    "w": "W",
    "h": "t",
    "d": "D",
    "material": "body",
    "grain": "horizontal",
    "edges": [
     "front",
     "left",
     "right"
    ]
   },
   {
    "type": "board",
    "name": "Bottom",
    "x": "t",
    "y": "legHeight",
    "z": 0,
    "w": "W - 2 * t",
    "h": "t",
    "d": "D",
    "material": "body",
    "grain": "horizontal",
    "edges": [
     "front"
    ]
   },
   {
    "type": "board",
    "name": "Side",
    "repeat": {
     "count": 2
    },
    "x": "i * (W - t)",
    "y": "legHeight",
    "z": 0,
    "w": "t",
    "h": "body - t",
    "d": "D",
    "material": "body",
    "edges": [
     "front"
    ]
   },
   {
    "type": "board",
    "name": "Back",
    "x": "t",
