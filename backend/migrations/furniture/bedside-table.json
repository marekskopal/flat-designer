    "when": "drawer",
    "x": "t + 2",
    "y": "H - t - 2 - dh",
    "z": 10,
    "w": "W - 2 * t - 4",
    "h": "dh",
    "d": "D - 10",
    "opens": "slide",
    "softClose": {
     "expr": "softClose"
    },
    "parts": [
     {
      "type": "front",
      "name": "Drawer front",
      "x": 0,
      "y": 0,
      "z": "AD - t",
      "w": "AW",
      "h": "AH",
      "d": "t",
      "material": "front",
      "kind": "drawer",
      "handle": "none",
      "grain": "horizontal"
     },
     {
      "type": "board",
      "name": "Drawer side",
      "repeat": {
       "count": 2,
       "as": "s"
      },
      "x": "s == 0 ? 10 : AW - 10 - 16",
