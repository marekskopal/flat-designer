{
 "name": "Linear pendant, oak",
 "description": "A long oak bar hanging on two cables, shining down through an opal strip in its underside. The item's elevation is the bar's bottom and its height reaches the ceiling, where the cables end; set the item's room.",
 "definition": {
  "format": 1,
  "category": "light",
  "schedule": {
   "values": [
    "lumens",
    "kelvin"
   ]
  },
