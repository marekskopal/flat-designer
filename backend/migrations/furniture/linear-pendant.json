     "count": 2
    },
    "x": "i == 0 ? 98 : W - 102",
    "y": "bar + 6",
    "z": "D / 2 - 2",
    "w": 4,
    "h": "H - bar - 6",
    "d": 4,
    "rose": 60,
    "sag": 0,
    "material": "cable"
   }
  ]
 }
}
