   },
   {
    "key": "lumens",
    "label": "Light output",
    "type": "int",
    "default": 2400,
    "min": 0,
    "max": 8000,
    "unit": "lm"
   },
   {
    "key": "kelvin",
    "label": "Colour temperature",
    "type": "int",
    "default": 3000,
    "min": 1800,
    "max": 6500,
    "unit": "K"
   }
  ],
  "materialSlots": [
   {
    "key": "wood",
    "label": "Bar",
    "default": "oak-solid"
   },
   {
    "key": "cable",
    "label": "Cables",
    "default": "cable-fabric-black"
   }
  ],
  "parts": [
   {
    "type": "led",
    "name": "Diffuser",
    "x": 20,
    "y": 0,
    "z": 10,
    "w": "W - 40",
    "h": 6,
    "d": "D - 20",
    "color": "#fff1dc",
    "intensity": 1
   },
   {
    "type": "block",
    "name": "Bar",
    "x": 0,
    "y": 6,
    "z": 0,
    "w": "W",
    "h": "bar",
    "d": "D",
    "material": "wood",
    "grain": "horizontal"
   },
   {
    "type": "light",
    "name": "Light",
    "repeat": {
     "count": 2
    },
    "x": "round(W * (2 * i + 1) / 4) - 50",
    "y": 0,
    "z": "D / 2 - 20",
