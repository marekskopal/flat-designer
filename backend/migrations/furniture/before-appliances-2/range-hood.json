{
 "name": "Range hood",
 "description": "Cooker hood above the hob: a wall chimney hood (a canopy and a chimney up to the item's top), a box (an island or ceiling hood: the whole box) or an integrated hood (only its front strip under a wall cabinet), lit underneath.",
 "definition": {
  "format": 1,
  "catalogue": "kitchen",
  "translations": {
   "cs": {
    "name": "Digestoř",
    "description": "Digestoř nad varnou deskou: komínová ke stěně (stříška a komín až k horní hraně prvku), box (ostrůvková nebo stropní: celý prvek) nebo vestavná (jen čelní lišta pod horní skříňkou), osvětlená zespodu.",
    "parameters": {
     "style": "Provedení"
    },
    "options": {
     "style": {
      "chimney": "komínová",
      "box": "box (ostrůvková, stropní)",
      "integrated": "vestavná"
     }
    },
    "slots": {
     "body": "Tělo"
    },
    "parts": {
     "Canopy": "Stříška",
     "Canopy top": "Horní část stříšky",
     "Chimney": "Komín",
     "Body": "Tělo",
     "Front strip": "Čelní lišta",
     "Light": "Osvětlení"
    }
   }
  },
  "size": {
   "width": 900,
   "depth": 500,
   "height": 1000
  },
  "parameters": [
   {
    "key": "style",
    "label": "Style",
    "type": "select",
    "options": [
     "chimney",
     "box",
     "integrated"
    ],
    "default": "chimney"
   }
  ],
  "materialSlots": [
   {
    "key": "body",
    "label": "Body",
    "default": "steel-stainless"
   }
  ],
  "parts": [
   {
    "type": "block",
    "name": "Canopy",
    "when": "style == 'chimney'",
    "x": 0,
    "y": 0,
    "z": 0,
    "w": "W",
    "h": 60,
    "d": "D",
    "material": "body"
   },
   {
    "type": "block",
    "name": "Canopy top",
    "when": "style == 'chimney'",
    "x": "round(W * 0.1)",
    "y": 60,
    "z": 0,
    "w": "round(W * 0.8)",
    "h": 100,
    "d": "round(D * 0.8)",
    "material": "body"
   },
   {
    "type": "block",
    "name": "Chimney",
    "when": "style == 'chimney' && H > 200",
    "x": "W / 2 - 150",
    "y": 160,
    "z": 0,
    "w": 300,
    "h": "H - 160",
    "d": "min(250, D)",
    "material": "body"
   },
   {
    "type": "block",
    "name": "Body",
    "when": "style == 'box'",
    "x": 0,
    "y": 0,
    "z": 0,
    "w": "W",
    "h": "H",
    "d": "D",
    "material": "body"
   },
   {
    "type": "block",
    "name": "Front strip",
    "when": "style == 'integrated'",
    "x": 0,
    "y": 0,
    "z": "D - 20",
    "w": "W",
    "h": "min(H, 30)",
    "d": 20,
    "material": "body"
   },
   {
    "type": "led",
    "name": "Light",
    "x": "round(W * 0.2)",
    "y": 1,
    "z": "style == 'integrated' ? D - 60 : round(D * 0.4)",
    "w": "round(W * 0.6)",
    "h": 2,
    "d": 20,
    "material": "body",
    "color": "#fff1dc"
   }
  ]
 }
}
