{
 "name": "Wall shelf",
 "description": "Boards stacked on two metal rods; hang it with the item elevation (z).",
 "definition": {
  "format": 1,
  "size": {
   "width": 1000,
   "depth": 250,
   "height": 600
  },
  "parameters": [
   {
    "key": "shelves",
    "label": "Boards",
    "type": "int",
    "default": 3,
    "min": 1,
    "max": 8
   },
   {
    "key": "t",
    "label": "Board thickness",
    "type": "int",
    "default": 25,
    "min": 12,
    "max": 50,
    "unit": "mm"
   }
  ],
  "derived": {
   "spacing": "(H - t) / max(shelves - 1, 1)"
  },
  "materialSlots": [
   {
    "key": "boards",
    "label": "Boards",
    "default": "kitchen-oak"
   },
   {
    "key": "rods",
    "label": "Rods",
    "default": "aluminium-brushed"
   }
  ],
  "parts": [
   {
    "type": "board",
    "name": "Shelf",
    "repeat": {
     "count": "shelves"
    },
    "x": 0,
    "y": "i * spacing",
    "z": 0,
    "w": "W",
    "h": "t",
    "d": "D",
    "material": "boards",
    "grain": "horizontal",
    "edges": [
     "front",
     "left",
     "right"
    ]
   },
   {
    "type": "cylinder",
    "name": "Rod",
    "when": "shelves > 1",
    "repeat": {
     "count": 2
    },
    "x": "60 + i * (W - 136)",
    "y": 0,
    "z": "D / 2 - 8",
    "w": 16,
    "h": "H",
    "d": 16,
    "material": "rods"
   }
  ]
 }
}
