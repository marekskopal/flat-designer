{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
	order mercure after encode
}

:80 {
	encode zstd gzip

	# Mercure hub for live updates of projects (FlatDesigner\Service\Realtime). Tokens are Mercure
	# protocol 1.0 access JWTs minted by the backend (MercureAccessToken) with iss "flat-designer" and aud
	# set to the resource identifier below, which docker-entrypoint.sh derives from MERCURE_PUBLISH_URL.
	mercure {
		issuer flat-designer {
			publisher {
				jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
			}
			subscriber {
				jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
			}
		}
		resource_identifier {$MERCURE_RESOURCE_IDENTIFIER}
		# Set by the backend as an HttpOnly cookie (MercureCookieIssuer); no __Host- prefix so it works
		# over plain http locally.
		cookie_name mercureAuthorization
		cors_origins {$BACKEND_CORS_ALLOWED_ORIGIN}
	}

	php {
		root /app/src
		worker {
			file frankenphp-worker.php
			num {$BACKEND_FRANKENPHP_WORKERS:2}
			match *
		}
	}
}
