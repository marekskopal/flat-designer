{
    "name": "marekskopal/flat-designer",
    "type": "project",
    "description": "Flat Designer – 3D viewer of a flat",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "league/container": "^5.0",
        "league/route": "^7.0",
        "marekskopal/orm": "^2.0",
        "marekskopal/orm-migrations": "^2.0",
        "marekskopal/router": "^1.1",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.19",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "shipmonk/phpstan-rules": "^4.0",
        "slevomat/coding-standard": "^8.14",
        "tomasvotruba/cognitive-complexity": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "FlatDesigner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatDesigner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
