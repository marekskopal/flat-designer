#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Izbik\Command\AdminCreateCommand;
use Izbik\Command\ExamplesExportCommand;
use Izbik\Command\FilesImportCommand;
use Izbik\Command\ModelsImportCommand;
use Izbik\Command\MigrationRunCommand;
use Izbik\Command\OrmSchemaDumpCommand;
use Izbik\Command\StorageBackupCommand;
use Izbik\Command\StorageRestoreCommand;
use Izbik\Command\UserResetPasswordCommand;
use Symfony\Component\Console\Application;

$application = new Application();

$application->addCommand(new AdminCreateCommand());
$application->addCommand(new ExamplesExportCommand());
$application->addCommand(new FilesImportCommand());
$application->addCommand(new ModelsImportCommand());
$application->addCommand(new MigrationRunCommand());
$application->addCommand(new OrmSchemaDumpCommand());
$application->addCommand(new StorageBackupCommand());
$application->addCommand(new StorageRestoreCommand());
$application->addCommand(new UserResetPasswordCommand());

$application->run();
