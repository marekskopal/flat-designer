# Flat Designer – local configuration. Copy to `.env` and adjust.

# Port the nginx proxy listens on (http://localhost:4400).
PROXY_PORT=4400

BACKEND_FRANKENPHP_WORKERS=2
# `production` (warnings + errors) or `debug` (verbose).
BACKEND_LOG_LEVEL=production
# Allowed Origin(s) for cross-origin calls to /api/*. Only needed when the Angular dev server
# calls the API directly; the proxy serves both from one origin.
BACKEND_CORS_ALLOWED_ORIGIN=*

# Secret signing the JWT access/refresh tokens, at least 32 characters. `make up` generates one
# into `.env` when it is missing (openssl rand -hex 32). Changing it signs everyone out.
AUTHORIZATION_TOKEN_KEY=
# Failed sign-ins before the account is locked, and the longest lock (seconds).
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_BACKOFF_CAP_SECONDS=3600

MYSQL_HOST=db
MYSQL_DATABASE=flat_designer
MYSQL_USER=flat_designer
MYSQL_PASSWORD=flat_designer
MYSQL_ROOT_PASSWORD=flat_designer

# Object storage for uploaded project files: the bundled MinIO, or real S3 (then clear S3_ENDPOINT and
# S3_USE_PATH_STYLE). The access key and secret are also MinIO's root credentials (secret: 8+ chars).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=flat-designer-files
S3_ACCESS_KEY=flat_designer
S3_SECRET_KEY=flat_designer_secret
S3_USE_PATH_STYLE=true
# MinIO admin console on http://localhost:<port>.
MINIO_CONSOLE_PORT=4401
# Largest accepted upload.
FILE_MAX_SIZE_MB=25

# MCP server (/mcp). PROXY_HOST: public hostname when served on a domain; the OAuth discovery documents
# then always advertise https://PROXY_HOST and MCP accepts that host. Empty for localhost.
PROXY_HOST=
# Lifetime of an MCP session without requests, seconds.
MCP_SESSION_TTL=86400

# Live updates (Mercure hub inside the backend). Keys sign the publisher and subscriber JWTs, at least 32
# characters each; `make env` generates them when empty. The publish URL is how the backend reaches its
# own hub (inside the container).
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
MERCURE_PUBLISH_URL=http://localhost/.well-known/mercure
