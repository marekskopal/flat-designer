# Flat Designer – local configuration. Copy to `.env` and adjust.

# Port the nginx proxy listens on (http://localhost:4400).
PROXY_PORT=4400

BACKEND_FRANKENPHP_WORKERS=2
# `production` (warnings + errors) or `debug` (verbose).
BACKEND_LOG_LEVEL=production
# Allowed Origin(s) for cross-origin calls to /api/*. Only needed when the Angular dev server
# calls the API directly; the proxy serves both from one origin.
BACKEND_CORS_ALLOWED_ORIGIN=*

MYSQL_HOST=db
MYSQL_DATABASE=flat_designer
MYSQL_USER=flat_designer
MYSQL_PASSWORD=flat_designer
MYSQL_ROOT_PASSWORD=flat_designer
